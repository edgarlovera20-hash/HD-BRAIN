// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Trend {
  up
  down
  flat
}

enum RiskSeverity {
  low
  medium
  high
  critical
}

enum RecommendationStatus {
  pending
  reviewed
}

model Kpi {
  id        String   @id @default(cuid())
  label     String
  value     Float
  unit      String
  trend     Trend    @default(flat)
  deltaPct  Float    @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model RiskSignal {
  id          String       @id @default(cuid())
  title       String
  severity    RiskSeverity @default(medium)
  platformSrc String
  description String
  detectedAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
}

model Recommendation {
  id             String               @id @default(cuid())
  title          String
  rationale      String
  priority       Int                  @default(1)
  targetPlatform String
  status         RecommendationStatus @default(pending)
  decisions      Decision[]
  createdAt      DateTime             @default(now())
}

model Decision {
  id                     String          @id @default(cuid())
  title                  String
  rationale              String
  linkedRecommendationId String?
  recommendation         Recommendation? @relation(fields: [linkedRecommendationId], references: [id])
  correlationId          String
  createdAt              DateTime        @default(now())
}
